# HTTP server port
PORT=5000

# PostgreSQL connection used by Prisma in local development
DATABASE_URL="postgresql://smart_user:smart_password@localhost:5432/smart_resources?schema=public"

# Long, random secret used to sign JWT access tokens
JWT_SECRET="replace-with-a-long-random-secret"

# Set to production in deployed environments
NODE_ENV=development

# Automatically generate demo readings in development (disabled in production)
AUTO_SIMULATOR=true
SIMULATOR_INTERVAL_MS=30000

# Address geocoding (OpenStreetMap Nominatim by default)
GEOCODING_URL="https://nominatim.openstreetmap.org/search"
GEOCODING_USER_AGENT="SmartResources/1.0 (https://github.com/YahyaM15/Projet_Dev_Web-YZS)"
